# Telegram Userbot (reading channels)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Telegram Bot (sending digests + admin UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPERGROUP_ID=
TELEGRAM_ADMIN_ID=

# LLM providers. Each task is routed across these and fails over on quota death
# (chains live in src/processor/llm/llm_client.py). Groq is required and tails
# every chain; the others are optional free-tier quotas that add headroom — a
# missing key just drops that provider (the bot alerts the admin about it).
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
ZHIPU_API_KEY=

# Cross-source deduplication (Gemini embeddings — separate endpoint/quota from Groq).
# Without GEMINI_API_KEY dedup is skipped (nothing is lost). Defaults in src/config.py.
GEMINI_API_KEY=
# DEDUP_ENABLED=true
# DEDUP_SHADOW=false         # true = log would-be duplicates without hiding them (validation only)
# DEDUP_THRESHOLD=0.86       # cosine at/above which two cross-source items are a candidate duplicate
# DEDUP_WINDOW_HOURS=24
# DEDUP_LOG_FLOOR=0.80       # log every cross-source candidate pair at/above this cosine (threshold tuning)
# EMBED_RPM=70               # cap embedding requests/min to stay under the Gemini free tier

# Within-source merge — reuses the same embeddings to pre-filter, the LLM decides same-event grouping.
# MERGE_VIA_EMBEDDINGS=true        # false = fall back to the old all-source group_by_topic path
# MERGE_PREFILTER_THRESHOLD=0.85   # below this, two items are never merge candidates (no LLM call)
# MERGE_NEAR_DUP_THRESHOLD=0.95    # at/above this, auto-merge without an LLM call (true reposts)

# Digest schedule
DIGEST_TIMEZONE=Europe/Berlin

# Database
DATABASE_PATH=data/sentinel.db

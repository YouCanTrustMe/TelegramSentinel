# Telegram Userbot (reading channels)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Telegram Bot (sending digests + admin UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPERGROUP_ID=
TELEGRAM_ADMIN_ID=

# Groq API. Models are routed per task with sensible defaults (see src/config.py):
#   classify (single-item summaries) -> openai/gpt-oss-120b
#   batch summarise + topic grouping -> llama-3.3-70b-versatile
#   shared quota-death fallback      -> llama-3.1-8b-instant
# Uncomment to override a default; leave unset otherwise.
GROQ_API_KEY=
# GROQ_MODEL_CLASSIFY=openai/gpt-oss-120b
# GROQ_MODEL_BATCH=llama-3.3-70b-versatile
# GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# Cross-source deduplication (Gemini embeddings — separate endpoint/quota from Groq).
# Without GEMINI_API_KEY dedup is skipped (nothing is lost). Defaults in src/config.py.
GEMINI_API_KEY=
# DEDUP_ENABLED=true
# DEDUP_SHADOW=false         # true = log would-be duplicates without hiding them (validation only)
# DEDUP_THRESHOLD=0.86
# DEDUP_WINDOW_HOURS=24
# EMBED_RPM=70               # cap embedding requests/min to stay under the Gemini free tier

# Digest schedule
DIGEST_TIMEZONE=Europe/Berlin

# Database
DATABASE_PATH=data/sentinel.db

# Telegram Userbot (reading channels)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Telegram Bot (sending digests + admin UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPERGROUP_ID=
TELEGRAM_ADMIN_ID=

# LLM providers. Each task is routed across these and fails over on quota death
# (chains live in src/processor/llm/llm_client.py). Mistral heads every chain,
# Gemini is the middle fallback and Groq tails; each sits on a separate free
# quota. A missing key just drops that provider (the bot alerts the admin).
# GEMINI_API_KEY below serves the text fallback; dedup embeddings run on MISTRAL_API_KEY.
GROQ_API_KEY=
MISTRAL_API_KEY=
ZHIPU_API_KEY=

# The middle LLM fallback. Cross-source deduplication embeds with mistral-embed and
# needs MISTRAL_API_KEY instead; without it dedup is skipped (nothing is lost).
# EMBED_PROVIDER=gemini switches embeddings back to Google. Defaults in src/config.py.
GEMINI_API_KEY=
# DEDUP_ENABLED=true
# DEDUP_SHADOW=false         # true = log would-be duplicates without hiding them (validation only)
# DEDUP_THRESHOLD=0.92       # cosine at/above which a candidate pair is logged as "strong"
# DEDUP_WINDOW_HOURS=48
# DEDUP_LOG_FLOOR=0.86       # union floor: pairs at/above become LLM-confirmed candidates
# EMBED_MODEL=mistral-embed  # embedding model for the active provider
# EMBED_RPM=300              # cap embedding texts/min; politeness, above any measured limit

# Within-source merge — reuses the same embeddings to pre-filter, the LLM decides same-event grouping.
# MERGE_VIA_EMBEDDINGS=true        # false = fall back to the old all-source group_by_topic path
# MERGE_PREFILTER_THRESHOLD=0.88   # below this, two items are never merge candidates (no LLM call)
# MERGE_NEAR_DUP_THRESHOLD=0.975   # at/above this, auto-merge without an LLM call (true reposts)

# Digest schedule
DIGEST_TIMEZONE=Europe/Berlin

# Database
DATABASE_PATH=data/sentinel.db
